# 注意：下面的绝对路径是示例，按你的实际部署目录改；跑 deploy/install_notify_stack.sh 会自动用你的 PROJECT_DIR 生成正确的单元。
[Unit]
Description=YOLOv8 SafeDetect (helmet/vest two-stage PPE detection)
After=network.target mosquitto.service
[Service]
Type=simple
User=firefly
Group=firefly
WorkingDirectory=/home/firefly/rk3568_camera/SafeDetect_V0.01
ExecStart=/usr/bin/python3 -u /home/firefly/rk3568_camera/SafeDetect_V0.01/app/safedetect_two_stage_rk3568.py --config /home/firefly/rk3568_camera/SafeDetect_V0.01/config/safe_config.json --source /dev/safecam --noshow --alertdir /home/firefly/rk3568_camera/SafeDetect_V0.01/alerts --stream 8090
Restart=on-failure
RestartSec=5
SuccessExitStatus=3
[Install]
WantedBy=multi-user.target